{
  "name": "pitch-in",
  "version": "0.1.0",
  "private": true,
  "description": "Neighbourhood bounties paid through PayPal only when an AI has checked the fix, and again when it lasts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@paypal/agent-toolkit": "^1.11.0",
    "ai": "^4.3.19",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@^7.3.8",
    "@bryntum/gantt-react": "^7.3.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
