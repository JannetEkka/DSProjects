# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Gemini key from aistudio.google.com/apikey
PAYPAL_HACK_GEMINI_API_KEY=
# Optional: a sandbox personal account, used only by the end-to-end test script
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Optional
PORT=8080
GEMINI_MODEL=gemini-2.5-flash
